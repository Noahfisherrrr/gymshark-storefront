# Copy to .env.local and fill in once the client provisions these accounts.
# Never commit .env.local — it's already in .gitignore.

# Supabase (Brief.md #14 — client owns this project; invite the dev account)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Stripe (Brief.md #9, #14 — client owns this account, must complete business verification)
VITE_STRIPE_PUBLISHABLE_KEY=

# Contentful (marketing banners — Delivery API, read-only; see docs/BACKEND_SUPABASE_STRATEGY.md)
VITE_CONTENTFUL_SPACE_ID=
VITE_CONTENTFUL_DELIVERY_TOKEN=
